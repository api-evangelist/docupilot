{
  "opencollection": "1.0.0",
  "info": {
    "name": "Docupilot accounts APIs ai Gallery templates API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "Gallery templates",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get list of galery templates",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/dashboard/accounts/v2/template_gallery/",
            "params": [
              {
                "name": "category",
                "value": "",
                "type": "query"
              },
              {
                "name": "ordering",
                "value": "",
                "type": "query",
                "description": "Which field to use when ordering the results."
              },
              {
                "name": "search",
                "value": "",
                "type": "query",
                "description": "A search term."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get list of galery templates"
        },
        {
          "info": {
            "name": "Get one template",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/dashboard/accounts/v2/template_gallery/:id/",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "A unique integer value identifying this template gallery."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get one template"
        }
      ]
    }
  ],
  "bundled": true
