            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "sessionid",
              "value": "{{sessionid}}",
              "placement": "query"
            }
          },
          "docs": "update current workspace details"
        },
        {
          "info": {
            "name": "Delete a workspace and other related data permanently",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/dashboard/accounts/v2/workspaces/current/delete/",
            "headers": [
              {
                "name": "X-Workspace",
                "value": ""
              }
