{
  "opencollection": "1.0.0",
  "info": {
    "name": "Docupilot accounts APIs ai history API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "history",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get created documents history",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/dashboard/api/v2/history/",
            "headers": [
              {
                "name": "X-Workspace",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "end_date",
                "value": "",
                "type": "query",
                "description": "DateTime in this format: 2019-05-02 16:25:12.353000"
              },
              {
                "name": "ordering",
                "value": "",
                "type": "query",
                "description": "Which field to use when ordering the results."
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "A page number within the paginated result set."
              },
              {
                "name": "start_date",
                "value": "",
                "type": "query",
                "description": "DateTime in this format: 2019-05-02 16:25:12.353000"
              },
              {
                "name": "status",
                "value": "",
                "type": "query"
              },
              {
                "name": "template",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get created documents history"
        },
        {
          "info": {
            "name": "download generated document if available",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/dashboard/api/v2/history/:id/download/",
            "headers": [
              {
                "name": "X-Workspace",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "A unique integer value identifying this merge history."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "sessionid",
              "value": "{{sessionid}}",
              "placement": "query"
            }
          },
          "docs": "download generated document if available"
        },
        {
          "info": {
            "name": "retry failed documents delivery",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/dashboard/api/v2/history/:id/retry_delivery/",
            "headers": [
              {
                "name": "X-Workspace",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "A unique integer value identifying this merge history."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "retry failed documents delivery"
        },
        {
          "info": {
            "name": "Get created export history",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/dashboard/api/v2/history/export/",
            "headers": [
              {
                "name": "X-Workspace",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "ordering",
                "value": "",
                "type": "query",
                "description": "Which field to use when ordering the results."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get created export history"
        },
        {
          "info": {
            "name": "Create export history task",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/dashboard/api/v2/history/export/",
            "headers": [
              {
                "name": "X-Workspace",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create export history task"
        },
        {
          "info": {
            "name": "download generated export document if available",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/dashboard/api/v2/history/export/:id/download/",
            "headers": [
              {
                "name": "X-Workspace",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "A unique integer value identifying this export merge history task."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "sessionid",
              "value": "{{sessionid}}",
              "placement": "query"
            }
          },
          "docs": "download generated export document if available"
        }
      ]
    }
  ],
  "bundled": true
}