{
  "opencollection": "1.0.0",
  "info": {
    "name": "Docupilot accounts APIs ai team API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "team",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all team members",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/accounts/team/",
            "params": [
              {
                "name": "ordering",
                "value": "",
                "type": "query",
                "description": "Which field to use when ordering the results."
              },
              {
                "name": "role",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "sessionid",
              "value": "{{sessionid}}",
              "placement": "query"
            }
          },
          "docs": "List all team members"
        },
        {
          "info": {
            "name": "Change role of team member at organization level.",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "{{baseUrl}}/accounts/team/:id/change_role/",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "sessionid",
              "value": "{{sessionid}}",
              "placement": "query"
            }
          },
          "docs": "Change role of team member at organization level."
        },
        {
          "info": {
            "name": "Activate or Deactivate a User",
            "type": "http"
