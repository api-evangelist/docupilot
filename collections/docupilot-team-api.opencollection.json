            "auth": {
              "type": "apikey",
              "key": "sessionid",
              "value": "{{sessionid}}",
              "placement": "query"
            }
          },
          "docs": "Activate or Deactivate a User"
        },
        {
          "info": {
            "name": "Transfer Ownership To Admin User",
