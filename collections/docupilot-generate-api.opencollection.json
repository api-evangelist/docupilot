{
  "opencollection": "1.0.0",
  "info": {
    "name": "Docupilot accounts APIs ai generate API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "generate",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Generate document from template",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/dashboard/api/v2/templates/:id/generate/",
            "headers": [
              {
                "name": "X-Client",
                "value": ""
              },
              {
                "name": "X-Workspace",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "download",
                "value": "",
                "type": "query"
              },
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "A unique integer value identifying this document."
              },
              {
                "name": "includeUrl",
                "value": "",
                "type": "query"
              },
              {
                "name": "output_type",
                "value": "",
                "type": "query"
              },
              {
                "name": "version",
                "value": "",
                "type": "query",
                "description": "Template version selector. Supports a numeric version id, `latest`, or `live`."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Generate document from template"
        },
        {
          "info": {
            "name": "Generates a test data used for testing template",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/dashboard/api/v2/templates/:id/generate_test_data/",
            "headers": [
              {
                "name": "X-Workspace",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "A unique integer value identifying this document."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "sessionid",
              "value": "{{sessionid}}",
              "placement": "query"
            }
          },
          "docs": "Generates a test data used for testing template"
        },
        {
          "info": {
            "name": "Test document generation",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/dashboard/api/v2/templates/:id/test/",
            "headers": [
              {
                "name": "X-Workspace",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "A unique integer value identifying this document."
              },
              {
                "name": "output_type",
                "value": "",
                "type": "query"
              },
              {
                "name": "version_id",
                "value": "",
                "type": "query",
                "description": "Template version selector. Supports a numeric version id, `latest`, or `live`."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "sessionid",
              "value": "{{sessionid}}",
              "placement": "query"
            }
          },
          "docs": "Test document generation"
        },
        {
          "info": {
            "name": "Get test data used for testing template",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/dashboard/api/v2/templates/:id/test_data/",
            "headers": [
              {
                "name": "X-Workspace",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "A unique integer value identifying this document."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get test data used for testing template"
        },
        {
          "info": {
            "name": "Generates a sample csv for the template using ai.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/dashboard/api/v2/templates/:template_id/generate/bulk/sample_csv/",
            "headers": [
              {
                "name": "X-Workspace",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "format",
                "value": "",
                "type": "query"
              },
              {
                "name": "template_id",
                "value": "",
                "type": "path",
                "description": "Template id"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "sessionid",
              "value": "{{sessionid}}",
              "placement": "query"
            }
          },
          "docs": "Generates a sample csv for the template using ai."
        },
        {
          "info": {
            "name": "Get document create link path",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/dashboard/api/v2/templates/:template_id/merge_links/",
            "headers": [
              {
                "name": "X-Workspace",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "template_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "URL to create document will be {host}/{path}"
        },
        {
          "info": {
            "name": "Create template merge link.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/dashboard/api/v2/templates/:template_id/merge_links/",
            "headers": [
              {
                "name": "X-Workspace",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "template_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create template merge link."
        },
        {
          "info": {
            "name": "delete_template_merge_link",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/dashboard/api/v2/templates/:template_id/merge_links/:id/",
            "headers": [
              {
                "name": "X-Workspace",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "A unique integer value identifying this document merge link."
              },
              {
                "name": "template_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Delete template merge link."
        }
      ]
    }
  ],
  "bundled": true
}