        {
          "info": {
            "name": "Update g2_review_updated_on",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/dashboard/accounts/v2/user_satisfaction_survey/update_g2_review_updated_on/",
            "auth": {
              "type": "apikey",
              "key": "sessionid",
              "value": "{{sessionid}}",
              "placement": "query"
            }
          },
          "docs": "Update g2_review_updated_on"
