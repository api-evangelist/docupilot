{
  "opencollection": "1.0.0",
  "info": {
    "name": "Docupilot accounts APIs ai user_satisfaction_survey API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "user_satisfaction_survey",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Redirect to G2 Review Page",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/dashboard/accounts/v2/user_satisfaction_survey/g2_review/",
            "auth": {
              "type": "apikey",
              "key": "sessionid",
              "value": "{{sessionid}}",
              "placement": "query"
            }
          },
          "docs": "Redirect to G2 Review Page"
        },
        {
          "info": {
            "name": "Update the next NPS reminder time",
